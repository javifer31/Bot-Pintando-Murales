# --- OpenRouter (acceso a modelos de lenguaje) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- WhatsApp Cloud API (Meta for Developers) ---
# Token permanente del System User de tu app de Meta con permiso whatsapp_business_messaging
WHATSAPP_TOKEN=EAAxxxxxxxx
# Phone Number ID (no el numero de telefono en si), desde WhatsApp > API Setup en Meta for Developers
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Token que tu inventas y pegas tambien en la configuracion del webhook en Meta
WHATSAPP_VERIFY_TOKEN=elige-un-token-secreto-aqui
# App Secret de tu app de Meta, para verificar la firma de los webhooks (recomendado en produccion)
WHATSAPP_APP_SECRET=

# --- Servidor ---
PORT=3000

# --- Ruta al fichero de configuracion del negocio ---
BUSINESS_CONFIG_PATH=./business.config.json
